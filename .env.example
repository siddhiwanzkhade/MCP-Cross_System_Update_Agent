# Copy these values into .mcp.json (the "env" section of each server).
# The servers do not read this file directly; it documents the settings.

# Who is making changes. Stand-in for a verified Keycloak identity in version 1.
AGENT_USER=siddhi

# Optional: where the SQLite database lives. Defaults to data/agent.db.
AGENT_DB_PATH=data/agent.db

# Optional: where the libraries and service repositories live. Defaults to data/workspace.
AGENT_WORKSPACE=data/workspace
